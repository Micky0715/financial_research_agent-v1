# Secrets / environment
.env
.env.local

# Python virtual environments
.venv/
venv/
env/

# Python bytecode / cache
__pycache__/
*.pyc
*.pyo

# OS cruft
.DS_Store
Thumbs.db

# Local editor/tool settings (machine-specific, not shared project config)
.vscode/
.idea/
.claude/settings.local.json

# --- outputs/ ---
# Per-run artifacts are regenerated by every `python main.py` / eval run and
# can get large fast - don't commit them by default. Final aggregated
# evaluation results (outputs/eval/) are the exception: they're small,
# human-readable, and are the actual v1 evaluation record, so they're kept.
outputs/cache/
outputs/traces/
outputs/sources/
outputs/evaluations/
outputs/reports/
outputs/baseline_reports/

# If you want to share a specific example report, copy it into examples/
# instead of relying on outputs/reports/ being committed.

# keep final evaluation artifacts
!outputs/eval/
!outputs/eval/*.md
!outputs/eval/*.csv
!outputs/eval/*.json

# transient eval run logs (regenerated every suite run)
outputs/eval/run_*.log
outputs/eval/run_*.err.log

# v3: exported final reports + memory index (regenerable artifacts)
outputs/final_reports/
memory/index/
*.docx
*.pdf

# v4: 披露模板 docx 例外提交
!templates/formal_research_report.docx
outputs/formal_reports/
outputs/tracking/
