# LLM provider key(s). LiteLLM routes based on MODEL_NAME, e.g.:
#   gpt-4o-mini            -> needs OPENAI_API_KEY
#   deepseek/deepseek-chat -> needs DEEPSEEK_API_KEY
#   claude-sonnet-5        -> needs ANTHROPIC_API_KEY
#   ollama/qwen2.5         -> needs OLLAMA_API_BASE (local, no key)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# Model routed through LiteLLM
MODEL_NAME=gpt-4o-mini

# Search / retrieval tuning
SEARCH_MAX_RESULTS=8
TOP_K_SOURCES=5

# ResearchAgent concurrency + fallback tuning
SEARCH_MAX_WORKERS=5
SEARCH_QUERY_TIMEOUT=15
SEARCH_TARGET_UNIQUE_RESULTS=40
SEARCH_MIN_UNIQUE_RESULTS=20

# Search result cache (outputs/cache/search_cache.json)
ENABLE_SEARCH_CACHE=true
SEARCH_CACHE_TTL_HOURS=24

# MCP tool routing: route web_search/read_webpage/read_pdf through the
# Model Context Protocol server (mcp_server/tools_server.py)
USE_MCP_TOOLS=true
MCP_TOOL_TIMEOUT=90

# Browser performance tuning: candidate read cap + early-stop once enough
# relevant sources are found (early_stop_count = max_sources * multiplier)
MAX_BROWSE_CANDIDATES=20
EARLY_STOP_RELEVANT_MULTIPLIER=2
MIN_RELEVANT_SCORE=0.5

# Analyze/report LLM input compression: char budget per source
MAX_ANALYSIS_CHARS_PER_SOURCE=1800
MAX_REPORT_EXCERPT_CHARS_PER_SOURCE=500

# Report output
OUTPUT_FORMAT=markdown

# Misc
LOG_LEVEL=INFO
REQUEST_TIMEOUT=10
